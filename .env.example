# Copy to .env.local and fill in once you have real accounts.
# Site is fully functional with none of these set — analytics scripts
# simply don't load. See docs/ANALYTICS_TRACKING_PLAN.md.

# https://analytics.google.com — GA4 property Measurement ID
NEXT_PUBLIC_GA_ID=

# https://clarity.microsoft.com — Project ID
NEXT_PUBLIC_CLARITY_ID=

# Canonical site URL used in metadata, sitemap.xml, robots.txt
NEXT_PUBLIC_SITE_URL=https://pgnearme.co.in
